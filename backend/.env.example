NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
# Required in production. Local development starts an actual persistent MongoDB process if omitted.
MONGODB_URI=
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
AI_PROVIDER=auto
# Auto selects Gemini when GEMINI_API_KEY is set, otherwise OpenAI. Explicit selection is also supported.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Rate pacing in milliseconds. 12000 targets 5 requests/minute for a reliable free-tier demo.
GEMINI_REQUEST_INTERVAL_MS=12000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Restrict user-controlled disruption controls to local demos. Default false in production.
ENABLE_DEMO_CONTROLS=true
